[Unit]
Description=AI Server (configurable launcher, see /etc/ai-server.conf)
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
User=root
WorkingDirectory=__WORK_DIR__
ExecStartPre=/bin/bash -c 'command -v nvidia-smi >/dev/null && nvidia-smi -pl 250 || true'
ExecStart=__LAUNCHERS_DIR__/dispatch.sh
Restart=on-failure
RestartSec=5
LimitNOFILE=65535

[Install]
WantedBy=multi-user.target