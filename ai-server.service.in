[Unit]
Description=AI Server (section-based config, see /etc/cortex-console/ai-server.conf)
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
User=root
WorkingDirectory=__WORK_DIR__
ExecStartPre=/bin/bash -c 'command -v nvidia-smi >/dev/null && nvidia-smi -pl 250 || true'
ExecStart=__DASH_DIR__/service/dispatch.sh
Restart=on-failure
RestartSec=5
LimitNOFILE=65535

[Install]
WantedBy=multi-user.target